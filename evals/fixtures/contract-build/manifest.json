{
  "manifest_version": 1,
  "service_name": "shop",
  "purpose": "A tiny shop with an inventory module and a storefront module, used by the Daedalus golden set.",
  "stack": {
    "language": "python",
    "runtime": "python3",
    "unit_test_cmd": "python3 -m unittest discover -s tests -q",
    "typecheck_cmd": null,
    "lint_cmd": null
  },
  "features": {
