    "scrub_file": null,
    "ledger": false,
    "dependency_web_lookup": false,
    "terraform_tools": false
  },
  "jail_narrowing": { "forbidden_paths": [], "forbidden_extensions": [] },
  "docs": { "literacy": null },
  "ledger": null
}
